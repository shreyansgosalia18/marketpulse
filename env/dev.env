# MarketPulse — Dev Environment Properties
#
# Local development only. Every value here is a public, non-sensitive
# default — safe to commit. There is no prod environment yet; when one
# exists, it will NOT be a variant of this file (prod Kafka/Postgres/Redis
# won't be run via this docker-compose.yml at all — see
# docs/reference/local-dev.md).
#
# Usage: docker compose --env-file env/dev.env up -d

# --- Network binding ---
# Keep at 127.0.0.1 so dev services are never reachable from the LAN —
# these credentials are intentionally weak.
BIND_HOST=127.0.0.1

# --- Kafka ---
KAFKA_PORT=9092

# --- PostgreSQL ---
POSTGRES_PORT=5432
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=marketpulse

# --- Redis ---
REDIS_PORT=6379
